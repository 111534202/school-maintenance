APP_NAME=Laravel
APP_ENV=local
APP_KEY=
# 開發時用 true；正式部署一定要改成 false（true 會在錯誤畫面洩漏程式與設定細節）。
APP_DEBUG=true
APP_URL=http://localhost
# 時區：預設台北。會影響所有存入與顯示的時間（最後登入時間、操作紀錄等）。
APP_TIMEZONE=Asia/Taipei

APP_LOCALE=zh_TW
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
# 是否顯示右上角的語言切換選單（預設隱藏）。要開放時取消下一行的註解並設成 true。
# APP_LOCALE_SWITCHER=true

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# 資料庫：四位組員各自使用本機的 MySQL（不共用資料庫）；資料表結構只透過 migration 同步，
# 測試資料只透過 seeder 同步。請先在本機 MySQL 建立 school_maintenance 資料庫，再把自己的密碼填在 .env（不要提交到 Git）。
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=school_maintenance
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
